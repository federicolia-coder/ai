RUNTIME_HOST=0.0.0.0
RUNTIME_PORT=8000
RUNTIME_SECRET=change-me-to-a-random-secret

# Path to your GGUF model file inside the container
MODEL_PATH=/app/models/model.gguf

# Context and generation limits
MAX_CONTEXT_LENGTH=4096
MAX_GENERATION_LENGTH=2048
MAX_CONCURRENT_REQUESTS=2
MAX_TOOL_CALLS=5
TOOL_TIMEOUT=30

# Optional: Brave Search API key for web search tool
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_PROVIDER=brave
