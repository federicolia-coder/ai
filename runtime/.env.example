RUNTIME_HOST=0.0.0.0
RUNTIME_PORT=8000
RUNTIME_SECRET=change-me-to-a-random-secret

# Qwen2.5-3B-Instruct Q4_K_M (~2GB RAM)
MODEL_PATH=/app/model/weights/qwen2.5-3b-instruct-q4_k_m.gguf

# Tuned for 2 vCore / 4GB RAM VPS
MAX_CONTEXT_LENGTH=2048
MAX_GENERATION_LENGTH=512
MAX_CONCURRENT_REQUESTS=1
MAX_TOOL_CALLS=3
TOOL_TIMEOUT=20

# Optional: Brave Search API key for web search tool
# WEB_SEARCH_API_KEY=
# WEB_SEARCH_PROVIDER=brave
